{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noland-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
